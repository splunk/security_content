      },
      "StoryUseCase": {
         "description": "Enum for story use cases.\n\nTODO: Provide information and authoritative documentation around where these\nare defined in Enterprise Security or how they render.",
         "enum": [
            "Fraud Detection",
            "Compliance",
            "Application Security",
            "Security Monitoring",
            "Advanced Threat Detection",
            "Insider Threat",
            "Other"
         ],
         "title": "StoryUseCase",
         "type": "string"
      }
